# Скопируйте в /etc/botfp/botfp.env и закройте от посторонних:
#   sudo mkdir -p /etc/botfp
#   sudo cp deploy/botfp.env.example /etc/botfp/botfp.env
#   sudo chown root:botfp /etc/botfp/botfp.env
#   sudo chmod 640 /etc/botfp/botfp.env

# Cookie golden_key аккаунта FunPay. Полный доступ к аккаунту — держите здесь,
# а не в config.toml, который лежит рядом с кодом.
FUNPAY_GOLDEN_KEY=вставьте_сюда

# Python не буферизует вывод — логи появляются в journalctl сразу.
PYTHONUNBUFFERED=1
